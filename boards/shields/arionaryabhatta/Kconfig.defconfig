if SHIELD_arixaaryabhatta

config ZMK_KEYBOARD_NAME
    default "arixaaryabhatta"

config I2C
	default y

# The bongo cat animates from typing speed
config ZMK_WPM
	default y if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

if LVGL

config LV_Z_VDB_SIZE
	default 64

config LV_DPI_DEF
	default 148

config LV_Z_BITS_PER_PIXEL
	default 1

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

# Widgets and font used by the custom status screen (LVGL 9 builds only
# what is enabled)
config LV_USE_LABEL
	default y

config LV_USE_IMAGE
	default y

config LV_USE_LINE
	default y

config LV_USE_ANIMIMG
	default y

config LV_USE_CANVAS
	default y

config LV_FONT_UNSCII_8
	default y

endif # LVGL

endif # SHIELD_arixaaryabhatta
